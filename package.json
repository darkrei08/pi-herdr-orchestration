{
  "name": "pi-herdr-orchestration",
  "version": "1.3.0",
  "description": "Deterministic multi-agent repository orchestration for Pi, Herdr, and AI coding agents",
  "type": "module",
  "main": "skills/pi-herdr-orchestrator/scripts/check-environment.mjs",
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:strict": "node scripts/check.mjs --strict",
    "check:json": "node scripts/check.mjs --json",
    "check:mcp": "node skills/pi-herdr-orchestrator/scripts/check-mcp.mjs --json",
    "check:anthropic-small-business": "node skills/pi-herdr-orchestrator/scripts/check-anthropic-small-business.mjs --json",
    "flow:glossary": "node scripts/flow-glossary.mjs",
    "flow:sources:check": "node scripts/flow-sources-check.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:apply": "node scripts/bootstrap.mjs --apply",
    "init-repo": "node scripts/init-repo.mjs",
    "init-repo:apply": "node scripts/init-repo.mjs --apply",
    "mailbox": "node scripts/mailbox.mjs",
    "mailbox:status": "node scripts/mailbox.mjs status",
    "test:dispatch": "node --test skills/pi-herdr-orchestrator/scripts/dispatch.test.mjs",
    "test:graph": "node --test skills/pi-herdr-orchestrator/scripts/graph-supervisor.test.mjs",
    "graph:plan:rust": "node scripts/graph-plan-rust.mjs",
    "check:rust": "cargo fmt --manifest-path rust/orchestrator-core/Cargo.toml -- --check && cargo check --manifest-path rust/orchestrator-core/Cargo.toml",
    "test:rust": "cargo test --manifest-path rust/orchestrator-core/Cargo.toml && node --test scripts/graph-plan-rust.test.mjs",
    "test:anthropic-small-business": "node --test skills/pi-herdr-orchestrator/scripts/check-anthropic-small-business.test.mjs",
    "test": "node --test skills/pi-herdr-orchestrator/scripts/mailbox.test.mjs skills/pi-herdr-orchestrator/scripts/dispatch.test.mjs skills/pi-herdr-orchestrator/scripts/graph-supervisor.test.mjs skills/pi-herdr-orchestrator/scripts/capability-preflight.test.mjs skills/pi-herdr-orchestrator/scripts/check-anthropic-small-business.test.mjs skills/pi-herdr-orchestrator/scripts/init-repository.test.mjs"
  },
  "keywords": [
    "pi",
    "pi-package",
    "herdr",
    "orchestrator",
    "multi-agent",
    "skills",
    "ai-agents"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.mjs",
      "./extensions/capability-preflight.mjs"
    ],
    "skills": [
      "./skills/pi-herdr-orchestrator",
      "./skills/anthropic-small-business-pi",
      "./skills/dev-flow"
    ]
  },
  "author": "darkrei08",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkrei08/pi-herdr-orchestration.git"
  }
}
