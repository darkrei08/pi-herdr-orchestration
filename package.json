{
  "name": "pi-herdr-orchestration",
  "version": "1.2.0",
  "description": "Deterministic multi-agent repository orchestration for Pi, Herdr, and AI coding agents",
  "type": "module",
  "main": "skills/pi-herdr-orchestrator/scripts/check-environment.mjs",
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:strict": "node scripts/check.mjs --strict",
    "check:json": "node scripts/check.mjs --json",
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:apply": "node scripts/bootstrap.mjs --apply",
    "init-repo": "node scripts/init-repo.mjs",
    "init-repo:apply": "node scripts/init-repo.mjs --apply",
    "mailbox": "node scripts/mailbox.mjs",
    "mailbox:status": "node scripts/mailbox.mjs status",
    "test": "node --test skills/pi-herdr-orchestrator/scripts/mailbox.test.mjs"
  },
  "keywords": [
    "pi",
    "pi-package",
    "herdr",
    "orchestrator",
    "multi-agent",
    "skills",
    "ai-agents"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.mjs"
    ],
    "skills": [
      "./skills/pi-herdr-orchestrator"
    ]
  },
  "author": "darkrei08",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkrei08/pi-herdr-orchestration.git"
  }
}
