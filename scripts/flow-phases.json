{
  "schema": "pi-herdr-orchestration/development-flow/v1",
  "routes": {
    "matt-ticket-pipeline": "Use Matt's ticket pipeline when the work starts as an issue, needs a spec, or needs ticket decomposition.",
    "engineering-excellence-sdd": "Use Engineering Excellence SDD for a repository that adopts its software design and delivery cycle.",
    "gentle-sdd": "Use Gentle SDD when the Gentle review and delivery authority owns the SDD cycle.",
    "gentle-odd": "Use Gentle ODD (Organic Driven Development) when the work follows Gentle AI's 7-phase adaptive workflow (Authorize -> Explore -> Resolve Uncertainty -> Classify -> Track -> Implement -> Close)."
  },
  "skillRoots": [
    "~/.agents/skills",
    "~/.pi/agent/skills",
    "~/.pi/agent/npm/node_modules/gentle-pi/skills"
  ],
  "phases": [
    {
      "id": "chart",
      "title": "Chart",
      "purpose": "Turn the request into a bounded decision and choose exactly one development route.",
      "skills": [
        "ask-matt",
        "chief-of-staff",
        "find-skills",
        "gentle-ai",
        "grill-me",
        "grill-with-docs",
        "grilling",
        "loop-me",
        "multi-repo-product-workflow",
        "pi-herdr-orchestrator",
        "to-questionnaire",
        "triage",
        "wayfinder"
      ],
      "mandatoryByRoute": {
        "matt-ticket-pipeline": [
          "triage"
        ],
        "engineering-excellence-sdd": [
          "engineering-excellence"
        ],
        "gentle-sdd": [
          "gentle-ai"
        ],
        "gentle-odd": [
          "gentle-ai"
        ]
      },
      "consumes": "The user's request, repository instructions, current Git state, and the capability report.",
      "handsOn": "One decision ticket or bounded implementation brief, one selected route, and the smallest sufficient skill set.",
      "failurePrevents": "Starting implementation with an ambiguous goal, incompatible pipelines, or unavailable skills.",
      "practices": [
        "A decision ticket names the decision it closes, never a slice of work to execute."
      ],
      "conditionalSkills": []
    },
    {
      "id": "spec",
      "title": "Spec",
      "purpose": "Describe the observable behavior, seams, constraints, and acceptance evidence before code exists.",
      "skills": [
        "cognitive-doc-design",
        "codebase-design",
        "domain-modeling",
        "engineering-excellence",
        "gentle-ai",
        "issue-creation",
        "issue-ops",
        "orient",
        "project-memory",
        "research",
        "reusable-data-search",
        "setup-matt-pocock-skills",
        "to-spec",
        "to-tickets",
        "writing-for-agents"
      ],
      "mandatoryByRoute": {
        "matt-ticket-pipeline": [
          "to-spec",
          "to-tickets"
        ],
        "engineering-excellence-sdd": [
          "engineering-excellence"
        ],
        "gentle-sdd": [
          "gentle-ai"
        ],
        "gentle-odd": [
          "gentle-ai"
        ]
      },
      "consumes": "The chart, repository evidence, existing interfaces, and the selected route's method.",
      "handsOn": "A spec or ticket graph with named seams, acceptance criteria, and blocking edges.",
      "failurePrevents": "Coding against an untestable idea, duplicating an existing seam, or losing the route's ownership boundary.",
      "practices": [
        "The seams are named before any code exists, and the highest existing seam wins."
      ],
      "conditionalSkills": []
    },
    {
      "id": "implement",
      "title": "Implement",
      "purpose": "Make the smallest change that satisfies the spec while preserving existing behavior.",
      "skills": [
        "engineering-excellence",
        "gentle-ai",
        "go-testing",
        "implement",
        "implement-spec",
        "prototype",
        "setup-pre-commit",
        "tdd",
        "teach",
        "tigerstyle"
      ],
      "mandatoryByRoute": {
        "matt-ticket-pipeline": [
          "implement",
          "tdd"
        ],
        "engineering-excellence-sdd": [
          "engineering-excellence",
          "tdd"
        ],
        "gentle-sdd": [
          "gentle-ai",
          "tdd"
        ],
        "gentle-odd": [
          "gentle-ai",
          "tdd"
        ]
      },
      "consumes": "The approved spec or ticket graph, the existing seam, and the chosen route's handoff.",
      "handsOn": "A minimal implementation, an observed red for each new rule, and updated tests or fixtures.",
      "failurePrevents": "Spec drift, speculative features, and tests that only mirror implementation details.",
      "practices": [
        "One observed red per rule; an existing behaviour that shares the changed code gets one test proving it still holds."
      ],
      "conditionalSkills": [
        {
          "when": "only when the change touches a user interface",
          "skills": [
            "animation-vocabulary",
            "apple-design",
            "design",
            "design-taste-frontend",
            "email-html-mjml",
            "emil-design-eng",
            "heroui-react",
            "impeccable",
            "phantom-ui"
          ]
        }
      ]
    },
    {
      "id": "verify",
      "title": "Verify",
      "purpose": "Run the focused checks and the claimed platform or runtime checks, then record their evidence.",
      "skills": [
        "browseros-neo",
        "container-test-matrix",
        "crowdsec",
        "crowdsec-service-api",
        "firecrawl-agent",
        "git-guardrails-claude-code",
        "herdr",
        "lightpanda",
        "pi-model-fit",
        "security-audit",
        "skill-creator",
        "skillopt-sleep",
        "wizard"
      ],
      "mandatoryByRoute": {
        "matt-ticket-pipeline": [],
        "engineering-excellence-sdd": [],
        "gentle-sdd": [],
        "gentle-odd": []
      },
      "consumes": "The implementation, its tests, the claimed environments, and any route-specific verification obligations.",
      "handsOn": "Recorded commands and outputs, including platform evidence where the change makes a platform claim.",
      "failurePrevents": "Calling a change verified because a local suite is green when the real target or boundary was not exercised.",
      "practices": [
        "The evidence is a recorded command and its output, not a green suite alone; a platform claim is run on that platform."
      ],
      "conditionalSkills": []
    },
    {
      "id": "review",
      "title": "Review",
      "purpose": "Check the candidate against the spec and repository standards without laundering pre-existing debt into the finding.",
      "skills": [
        "code-review",
        "comment-writer",
        "diagnosing-bugs",
        "improve-codebase-architecture",
        "judgment-day",
        "learning-opportunities",
        "rdd-defect-workflow",
        "skill-improver",
        "skill-registry"
      ],
      "mandatoryByRoute": {
        "matt-ticket-pipeline": [
          "code-review"
        ],
        "engineering-excellence-sdd": [
          "code-review"
        ],
        "gentle-sdd": [
          "code-review"
        ],
        "gentle-odd": [
          "code-review"
        ]
      },
      "consumes": "The diff, verification evidence, the originating spec, and the fixed review point.",
      "handsOn": "Findings with file and line evidence, a disposition for pre-existing issues, and an approved candidate or bounded fixes.",
      "failurePrevents": "Missing a regression, confusing style preference with a defect, or blocking the candidate on unrelated debt.",
      "practices": [
        "A finding carries its file and line, and a pre-existing issue is a follow-up, never a blocker dressed as the candidate's fault."
      ],
      "conditionalSkills": []
    },
    {
      "id": "deliver",
      "title": "Deliver",
      "purpose": "Package the reviewed behavior as a coherent work unit with the required handoff or review artifact.",
      "skills": [
        "branch-pr",
        "chained-pr",
        "claude-handoff",
        "handoff",
        "pr",
        "work-unit-commits"
      ],
      "mandatoryByRoute": {
        "matt-ticket-pipeline": [
          "work-unit-commits"
        ],
        "engineering-excellence-sdd": [
          "work-unit-commits"
        ],
        "gentle-sdd": [
          "work-unit-commits"
        ],
        "gentle-odd": [
          "work-unit-commits"
        ]
      },
      "consumes": "The reviewed candidate, its evidence, and any required issue or PR metadata.",
      "handsOn": "One reviewable work unit, with tests and docs beside the behavior and a precise handoff.",
      "failurePrevents": "Shipping an unreviewable slice, separating the docs from the behavior, or losing the verification record.",
      "practices": [
        "One work unit per commit, tests and docs with the behaviour."
      ],
      "conditionalSkills": []
    },
    {
      "id": "close",
      "title": "Close",
      "purpose": "State what was completed, what was skipped, and what remains before ending the work.",
      "skills": [
        "project-memory",
        "retro",
        "show-me",
        "wait-what",
        "writing-for-agents"
      ],
      "mandatoryByRoute": {
        "matt-ticket-pipeline": [
          "retro"
        ],
        "engineering-excellence-sdd": [
          "retro"
        ],
        "gentle-sdd": [
          "retro"
        ],
        "gentle-odd": [
          "retro"
        ]
      },
      "consumes": "The final diff, commit or handoff, verification output, and review disposition.",
      "handsOn": "A concise completion report, durable memory where warranted, and explicit gaps or next actions.",
      "failurePrevents": "A false claim of completeness caused by silently omitted or unverified work.",
      "practices": [
        "Every skipped or unverified item is stated, because an unmentioned gap is a false claim of completeness."
      ],
      "conditionalSkills": []
    }
  ],
